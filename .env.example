# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# WAQI_API_KEY: Optional World Air Quality Index (aqicn.org) token.
# When omitted, HAWA JANO uses Open-Meteo Copernicus CAMS live air quality & weather data.
WAQI_API_KEY=
